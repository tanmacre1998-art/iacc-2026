% ---------- Comandos para la carta ----------
% \fechacarta{Bogotá D.C., 1 de octubre de 2026}
\newcommand{\fechacarta}[1]{\noindent #1\par\vspace{1.6em}}

% \destinatario{Profesor}{Nombre Apellido}{Cargo}{Institución}
\newcommand{\destinatario}[4]{%
  \noindent\textbf{#1}\\
  \textbf{#2}\\
  #3\\
  #4\par\vspace{1.6em}}

% \asunto{Invitación como conferencista ...}
\newcommand{\asunto}[1]{\noindent\textbf{Asunto:} #1\par\vspace{1.4em}}

% \saludo{Apreciado profesor Apellido:}
\newcommand{\saludo}[1]{\noindent #1\par\vspace{0.6em}}

% \firma{Nombre}{Cargo}{Institución}  (se pueden poner dos seguidas)
\newcommand{\firma}[3]{%
  \begin{minipage}[t]{0.48\textwidth}
    \vspace{2.6em}\rule{5.2cm}{0.4pt}\\
    \textbf{#1}\\
    #2\\
    {\small\color{iaccgris}#3}
  \end{minipage}\hfill}

\endinput
