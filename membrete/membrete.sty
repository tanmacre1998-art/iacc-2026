% ============================================================
%  membrete.sty — papel membreteado oficial del Programa Académico
%  de Matemáticas (FCMN, Universidad Distrital) con la marca del
%  II Encuentro IACC integrada.
%
%  Compilar con LuaLaTeX (dos veces la primera vez):
%      lualatex carta-invitacion.tex
%  Usa la tipografía Cambria del sistema para el membrete oficial
%  y STIX Two Text para el cuerpo y la marca.
%
%  Reproduce la plantilla MATEMATICAS_FCMN.dot: mismos márgenes,
%  cabecera (escudo + facultad + programa) y pie (PBX, dirección,
%  acreditación, línea de atención, correo). La marca del encuentro
%  va a la derecha de la cabecera, con el sello de los 15 años de ITENUA.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{membrete}[2026/09/22 Membrete oficial FCMN + II Encuentro IACC]

\RequirePackage{fontspec}
\RequirePackage[spanish,es-noshorthands]{babel}
\RequirePackage[letterpaper,top=4.5cm,bottom=4.4cm,left=3cm,right=2cm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{microtype}
\RequirePackage{parskip}
\RequirePackage{hyperref}

% ---------- Tipografías ----------
\setmainfont{STIXTwoText}[
  Extension=.otf, UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-Bold, BoldItalicFont=*-BoldItalic]
\newfontfamily\cambria{Cambria}[BoldFont={Cambria Bold}, ItalicFont={Cambria Italic}, Ligatures=TeX]      % tipografía del membrete oficial

% ---------- Paleta ----------
\definecolor{iaccrojo}{HTML}{C9151E}
\definecolor{iaccamarillo}{HTML}{F4D300}
\definecolor{iaccnegro}{HTML}{1A1A1A}
\definecolor{iaccgris}{HTML}{73777F}
\color{iaccnegro}
\hypersetup{colorlinks=true, urlcolor=iaccnegro, linkcolor=iaccnegro, pdfauthor={Programa Académico de Matemáticas, Universidad Distrital}}

% Los difuminados se hacen con sombreado hacia blanco (no con transparencia)
% para que se vean igual en cualquier visor de PDF.

% ---------- Isologo (mismas proporciones que marca.js). #1 = ancho en cm ----------
\newcommand{\isologo}[1]{%
  \begin{tikzpicture}[baseline=(base)]
    \pgfmathsetmacro{\s}{#1/6.214}
    \begin{scope}[scale=\s, transform shape, line cap=round]
      \coordinate (base) at (0,0);
      \shade[left color=iaccamarillo, middle color=iaccamarillo!88!white, right color=iaccamarillo!6!white] (0,0) -- (1,0) -- (0.5,0.866) -- cycle;
      \shade[left color=iaccrojo!6!white, middle color=iaccrojo!88!white, right color=iaccrojo] (5.214,0.866) -- (6.214,0.866) -- (5.714,0) -- cycle;
      \draw[iaccnegro, line width={\s*0.8pt}] (0.5,0.866) -- (5.214,0.866);
      \draw[iaccnegro, line width={\s*0.8pt}] (1,0) -- (5.714,0);
      \node[anchor=base west, inner sep=0, text=iaccrojo, font=\itshape\fontsize{6.1pt}{0pt}\selectfont] at (0.853,0.625) {II Encuentro};
      \node[anchor=base west, inner sep=0, text=iaccnegro, font=\fontsize{6.6pt}{0pt}\selectfont] at (1.004,0.364) {Interacciones entre Álgebra,};
      \node[anchor=base west, inner sep=0, text=iaccnegro, font=\fontsize{6.6pt}{0pt}\selectfont] at (1.154,0.104) {Combinatoria y la Computación};
    \end{scope}
  \end{tikzpicture}%
}

% Isotipo: solo los dos triángulos. #1 = ancho en cm
\newcommand{\isotipo}[1]{%
  \begin{tikzpicture}[baseline=(base)]
    \pgfmathsetmacro{\s}{#1/2.143}
    \begin{scope}[scale=\s]
      \coordinate (base) at (0,0);
      \shade[left color=iaccamarillo, middle color=iaccamarillo!88!white, right color=iaccamarillo!6!white] (0,0) -- (1,0) -- (0.5,0.866) -- cycle;
      \shade[left color=iaccrojo!6!white, middle color=iaccrojo!88!white, right color=iaccrojo] (1.143,0.866) -- (2.143,0.866) -- (1.643,0) -- cycle;
    \end{scope}
  \end{tikzpicture}%
}

