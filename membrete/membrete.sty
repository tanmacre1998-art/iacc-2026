% ---------- Isologo (mismas proporciones que marca.js) ----------
% #1 = ancho total en cm, por ejemplo \isologo{9}
\newcommand{\isologo}[1]{%
  \begin{tikzpicture}[baseline=(base)]
    \pgfmathsetmacro{\s}{#1/6.214}
    \begin{scope}[scale=\s, transform shape, line cap=round]
      \coordinate (base) at (0,0);
      \fill[iaccamarillo, path fading=iaccfadeE] (0,0) -- (1,0) -- (0.5,0.866) -- cycle;
      \fill[iaccrojo, path fading=iaccfadeW] (5.214,0.866) -- (6.214,0.866) -- (5.714,0) -- cycle;
      \draw[iaccnegro, line width={\s*0.8pt}] (0.5,0.866) -- (5.214,0.866);
      \draw[iaccnegro, line width={\s*0.8pt}] (1,0) -- (5.714,0);
      \node[anchor=base west, inner sep=0, text=iaccrojo, font=\itshape\fontsize{6.1pt}{0pt}\selectfont] at (0.853,0.625) {II Encuentro};
      \node[anchor=base west, inner sep=0, font=\fontsize{6.6pt}{0pt}\selectfont] at (1.004,0.364) {Interacciones entre Álgebra,};
      \node[anchor=base west, inner sep=0, font=\fontsize{6.6pt}{0pt}\selectfont] at (1.154,0.104) {Combinatoria y la Computación};
    \end{scope}
  \end{tikzpicture}%
}

% Isotipo: solo los dos triángulos. #1 = ancho en cm
\newcommand{\isotipo}[1]{%
  \begin{tikzpicture}[baseline=(base)]
    \pgfmathsetmacro{\s}{#1/2.143}
    \begin{scope}[scale=\s]
      \coordinate (base) at (0,0);
      \fill[iaccamarillo, path fading=iaccfadeE] (0,0) -- (1,0) -- (0.5,0.866) -- cycle;
      \fill[iaccrojo, path fading=iaccfadeW] (1.143,0.866) -- (2.143,0.866) -- (1.643,0) -- cycle;
    \end{scope}
  \end{tikzpicture}%
}

